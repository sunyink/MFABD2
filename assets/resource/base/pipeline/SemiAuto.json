    "SemiAuto_Evil_SemiautoTower_Timeout": {
        "desc": "半自动爬塔的时间闸,超过上限就收工。识别逻辑是反的:已超时才算命中,未超时返回失败让引擎继续试 next 里的后续候选,因此挂在各循环节点 next 首位不改变原有候选语义。上限由 interface.json 的「半自动爬塔时间上限」注入,默认 30 分钟,填 0 为不限时。为什么这条链需要时间界见 agent/recognition/timer.py 的模块注释。",
        "recognition": "Custom",
        "custom_recognition": "TimerExpired",
        "custom_recognition_param": {
            "timer": "EvilTower",
            "minutes": 30
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "SemiAuto_Evil_SemiautoTower_End"
        ],
        "focus": "半自动-爬塔已达时间上限,收工"
    },
