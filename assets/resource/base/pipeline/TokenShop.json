{
    "TokenShop_Start": {
        "desc": "代币商店兑换入口：逐家商店各做一次，全部做完结束。商店的启用由 interface 改各 Hub 的 enabled。",
        "timeout": 2000,
        "next": [
            "Env_AgentLost_Stop",
            "[JumpBack]TokenShop_EventPast_Hub",
            "Global_Hub_End"
        ]
    },
    "Rec_TokenShop_ListArea_Clr": {
        "desc": "[识别]商品区范围，全色造框；各商品的名称只在这个框里找。覆盖包按端改 roi。",
        "recognition": "ColorMatch",
        "roi": [
            190,
            70,
            950,
            575
        ],
        "method": 4,
        "lower": [
            0,
            0,
            0
        ],
        "upper": [
            255,
            255,
            255
        ]
    },
    "Sub_TokenShop_Price_Ocr": {
        "desc": "[检测]商品名称正下方价格条上的数字（有限购行的格子）。借名称框 ItemName 向下偏移，上沿落在限购行之下；买完的格子这里是「购买成功／購買完成」，认不到数字。",
        "recognition": "OCR",
        "roi": "ItemName",
        "roi_offset": [
            -30,
            53,
            60,
            30
        ],
        "expected": [
            "^[0-9][0-9,.]{0,8}$"
        ]
    },
    "Sub_TokenShop_PriceFree_Ocr": {
        "desc": "[检测]同 Sub_TokenShop_Price_Ocr，用于无限购的格子：没有限购行，名称靠下、价格离得近。",
        "recognition": "OCR",
        "roi": "ItemName",
        "roi_offset": [
            -30,
            40,
            60,
            30
        ],
        "expected": [
            "^[0-9][0-9,.]{0,8}$"
        ]
    },
    "Rec_TokenShop_BannerPast_Ocr": {
        "desc": "[识别]主页右侧赛季横幅停在上期：横幅上方的标签写着「结束」。roi 只盖赛季横幅这一格，不盖上面的促销横幅。",
        "recognition": "OCR",
        "roi": [
            1030,
            345,
            180,
            60
        ],
        "expected": [
            "^结束$",
            "^結束$"
        ]
    },
    "Rec_TokenShop_BannerNow_Ocr": {
        "desc": "[识别]主页右侧赛季横幅停在当期：标签写着「D-数字」。最后一天据说写「D-day」，没见过实图，先一并收。",
        "recognition": "OCR",
        "roi": [
            1030,
            345,
            180,
            60
        ],
        "expected": [
            "^D-?[0-9]{1,2}$",
            "^D-?[Dd][Aa][Yy]$"
        ]
    },
    "Rec_TokenShop_BuyButton_Ocr": {
        "desc": "[识别]购买弹窗右下的「购买」按钮文字。亮不亮由调用方另核。",
        "recognition": "OCR",
        "roi": [
            880,
            485,
            90,
            42
        ],
        "expected": [
            "^[购購][买買]$"
        ]
    },
    "TokenShop_Seek": {
        "desc": "找当前这件商品（锚点 ShopItemPick 指向它的识别节点）：先在当前页认，认到就去买；1.5 秒认不到，翻过页的先回顶（锚点 ShopListRewind 已设时），否则下翻。",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 1500,
        "rate_limit": 300,
        "next": [
            "[Anchor]ShopItemPick"
        ],
        "on_error": [
            "[Anchor]ShopListRewind",
            "TokenShop_Seek_Down"
        ]
    },
    "TokenShop_List_Rewind": {
        "desc": "把列表拖回顶部：反复上翻到画面不再变。做完清掉锚点 ShopListRewind，表示列表在顶部。只在翻过页之后才会走到。",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SmartAction",
        "custom_action_param": {
            "proxy_node": "Agt_TokenShop_List_Back",
            "detect_roi": [
                195,
                92,
                940,
                548
            ],
            "threshold": 3.0,
            "settle_delay": 0,
            "on_changed": "loop",
            "on_unchanged": "next",
            "loop_limit": 8,
            "loop_exhausted": "next"
        },
        "anchor": {
            "ShopListRewind": ""
        },
        "post_delay": 0,
        "next": [
            "TokenShop_Seek_Top"
        ]
    },
    "TokenShop_Seek_Top": {
        "desc": "回顶后在首屏再认一次当前这件；认不到就下翻。",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 1500,
        "rate_limit": 300,
        "next": [
            "[Anchor]ShopItemPick"
        ],
        "on_error": [
            "TokenShop_Seek_Down"
        ]
    },
    "TokenShop_Seek_Down": {
        "desc": "下翻一页，经 SmartAction 比对商品区前后两帧：画面变了去 TokenShop_Seek_Page 接着认；没变就是到底了，这件商品本轮不买（已买完或这期没有）。",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SmartAction",
        "custom_action_param": {
            "proxy_node": "Agt_TokenShop_List_Next",
            "detect_roi": [
                195,
                92,
                940,
                548
            ],
            "threshold": 3.0,
            "settle_delay": 0,
            "on_changed": "next",
            "on_unchanged": "error",
            "unchanged_streak": 1
        },
        "post_delay": 0,
        "timeout": 2000,
        "next": [
            "TokenShop_Seek_Page"
        ],
        "on_error": [
            "TokenShop_Seek_End"
        ]
    },
    "TokenShop_Seek_Page": {
        "desc": "已下翻到新的一页：设锚点 ShopListRewind（下一件开始前要回顶），在这一页认当前这件；认不到继续下翻。",
        "pre_delay": 0,
        "anchor": {
            "ShopListRewind": "TokenShop_List_Rewind"
        },
        "post_delay": 0,
        "timeout": 1500,
        "rate_limit": 300,
        "next": [
            "[Anchor]ShopItemPick"
        ],
        "on_error": [
            "TokenShop_Seek_Down"
        ]
    },
    "TokenShop_Seek_End": {
        "desc": "翻到底也没认到当前这件，回队列轮下一件。",
        "pre_delay": 0,
        "post_delay": 0
    },
