    "BagScan_Page_Next": {
        "desc": "py用run_task调用：经SmartAction代理Agt_BagScan_Page_Swipe下滑一页，比对列表区前后两帧。画面变了走BagScan_Page_Moved；连续两次没变走BagScan_Page_Bottom。SmartAction截图失败、滑动没发出去也会走Bottom，所以py收到Bottom后亲自补滑一次并确认动作执行了，列表仍不动才按到底处理。代理节点自带画面静止等待，这里不另加等待。",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SmartAction",
        "custom_action_param": {
            "proxy_node": "Agt_BagScan_Page_Swipe",
            "detect_roi": [
                578,
                62,
                600,
                634
            ],
            "threshold": 3.0,
            "settle_delay": 0,
            "on_changed": "next",
            "on_unchanged": "error",
            "unchanged_streak": 2
        },
        "post_delay": 0,
        "timeout": 2000,
        "next": [
            "BagScan_Page_Moved"
        ],
        "on_error": [
            "BagScan_Page_Bottom"
        ]
    },
