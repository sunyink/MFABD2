    "BagScan_Detail_Open": {
        "desc": "py用run_task调用：点开一个物品格子的详情，坐标由py注入target。按rate_limit重试识别，直到BagScan_Detail_Ready读到名称与「拥有/持有…个」；超时由py分清是没点开（再点一次）还是开了没读清（接着读，不再点）。不靠固定等待：出现动画走到一半时字可能是虚影或不在识别框内，读不全就继续重试。等待上限5秒：OCR慢的机器上一轮识别就要一秒，3秒会有两成格子等不到（11-12模拟器实测）。",
        "pre_delay": 0,
        "action": "Click",
        "target": [
            0,
            0,
            0,
            0
        ],
        "post_delay": 0,
        "timeout": 5000,
        "rate_limit": 100,
        "next": [
            "BagScan_Detail_Ready"
        ]
    },
    "BagScan_Detail_Ready": {
        "desc": "物品详情已可读：同一帧里数量（完整的「拥有/持有…个」）与名称都读到。数量排在前面：弹窗还在出现动画时数量先对不上，And 就此打住，这一轮少跑一次名称识别。py从这一帧的子识别结果按节点名取名称与数量，再截一帧复核，两帧名称、数量与数量文字位置一致才采信（agent/action/bag_scan.py）。",
        "recognition": "And",
        "all_of": [
            "Rec_BagScan_Quantity_Ocr",
            "Rec_BagScan_Name_Ocr"
        ],
        "pre_delay": 0,
        "post_delay": 0
    },
