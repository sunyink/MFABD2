{
    "Collect_Steal_Entry": {
        "desc": "吸取收尾顺手偷商人的入口：箱庭里认到寻路按钮才进来，清本链计数与锚点，每张卡偷没偷成都只进一次 | S1/S3/S5/S6 选卡时（Collect_Pack_Story_1/3/5/6）把锚点 Steal_Merchant 指向本节点，Collect_PackFinish 的 next 首位按锚点回跳进来。移动魔法阵面板还开着时认不到寻路按钮，PackFinish 先由 Global_ToSandBox 回到箱庭，下一轮才轮到这里。界面「采集顺手偷商人」选 No、或 PC 覆盖包，把本节点 enabled 关掉。",
        "enabled": true,
        "recognition": "Or",
        "any_of": [
            "Collect_WayPoint_Open_Tpl"
        ],
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "ClearNodeHitCount",
        "custom_action_param": {
            "node_name": [
                "Collect_Steal_Guide",
                "Collect_Steal_Shop",
                "Collect_Steal_MoveConfirm",
                "Collect_Steal_Open",
                "Collect_Steal_Slot1",
                "Collect_Steal_Slot2",
                "Collect_Steal_Slot3",
                "Collect_Steal_Slot4",
                "Collect_Steal_Slot5",
                "Collect_Steal_Confirm",
                "Collect_Steal_Close"
            ]
        },
        "anchor": {
            "Steal_Merchant": ""
        },
        "post_delay": 0,
        "next": [
            "Collect_Steal_Guide"
        ],
        "focus": "偷商人：开始"
    },
    "Collect_Steal_Guide": {
        "desc": "点开寻路列表 | 识别借 Collect_WayPoint_Open_Tpl（含 PC 素材）。按钮是开关，列表打开后模板认不到，自引用不会把列表点关；限 3 次。",
        "max_hit": 3,
        "recognition": "Or",
        "any_of": [
            "Collect_WayPoint_Open_Tpl"
