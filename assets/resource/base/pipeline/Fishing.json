    "Fishing_Minigame_Data": {
        "desc": "【钓鱼小游戏 1/4·数据·三端共用/勿删】小游戏的机制常量,由游戏本身决定,与设备和端无关;py 读取,缺项回落 py 内置默认。cursor_speed=游标移动速度(px/帧);blue_shrink=蓝区单边向心收缩速度(px/帧);cursor_half_cycle=游标单程帧数(一个完整往返=2倍此值);ref_fps=上面两个「每帧」速率所基于的帧率;minigame_seconds=单局时长上界(超时即收尾)。【注意】前四项互相咬合,共同决定「游标此刻在哪、朝哪走」的推算,改任一项都要连带复核其余三项。",
        "enabled": false,
        "attach": {
            "cursor_speed": 4.2,
            "blue_shrink": 0.83,
            "cursor_half_cycle": 88,
            "ref_fps": 60.0,
            "minigame_seconds": 17
        }
    },
    "Fishing_Minigame_Timing": {
        "desc": "【钓鱼小游戏 2/4·时序·per端可覆盖(attach 按 key 字典合并)】决策层到画面真正生效之间的时间差补偿,与设备/控制器性能相关。click_lead=点击提前量(判定「还追不追得上目标区」「蓝区归零前来不来得及」时预留的余量,秒);input_comp=从算完到点击生效的链路延迟(秒,直接从等待时长里扣);cursor_reset_wait=点击后游标复位等待(秒);after_cast=抛竿命中后进入小游戏的等待(秒);after_catch=上鱼后结算动画等待(秒)。【调参】点击总是偏早→调小 click_lead 与 input_comp;总是偏晚→调大。",
        "enabled": false,
        "attach": {
            "click_lead": 0.27,
            "input_comp": 0.045,
            "cursor_reset_wait": 0.6,
            "after_cast": 0.2,
            "after_catch": 3.0
        }
    },
    "Fishing_Minigame_Strategy": {
        "desc": "【钓鱼小游戏 3/4·策略·per端可覆盖】行为决策阈值;py 读取,缺项回落 py 内置默认。sell_interval=累计钓到几条触发一次自动卖鱼(亦可由 Custom_Fishing_Task 的 custom_action_param 同名键覆盖,该处优先);wait_cap=单次等待时长上限(秒,算出超过此值视为游戏状态已变,放弃本次点击);blue_min_width=蓝区预测宽度下限(px,预测到达时窄于此值则不点)。",
        "enabled": false,
