{
    "QuickHunt_Start": {
        "desc": "task入口,先排除Agent失联,再交给QuickHunt_Daily_Switch判存档。闸不通过时本节点next耗尽,整个task直接结束。Env_AgentLost_Stop必须排在闸前:闸是Custom识别,Agent失联时它只会静默不命中",
        "timeout": 1,
        "next": [
            "Env_AgentLost_Stop",
            "QuickHunt_Daily_Switch"
        ]
    },
    "QuickHunt_Daily_Switch": {
        "desc": "快速狩猎存档闸:本游戏日已确认免费米饭与火把都扫空(QuickHunt_Daily_Mark打过标)则不命中,整个task直接结束。想强制重跑用选项<快速狩猎日常-强制重跑>",
        "recognition": "Custom",
        "custom_recognition": "CheckCoolDown",
        "custom_recognition_param": {
            "card_name": "QuickHunt_Daily",
            "cycle_type": "g_daily"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "QuickHunt_Daily_ResetTags"
        ]
    },
    "QuickHunt_Daily_ResetTags": {
        "desc": "本轮快速狩猎开始前清零米饭、火把耗尽tag,避免沿用上轮或其他存档的内存标记。0表示未确认,检测耗尽后UpdateTag写为-1",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "ResetTag",
        "custom_action_param": {
            "tags": [
                "RiceAP_Zero",
                "TorchAP_Zero"
            ]
        },
        "post_delay": 0,
        "next": [
            "QuickHunt_Hub"
        ]
    },
    "QuickHunt_Hub": {
        "desc": "快速狩猎调度器。免费米饭分两段:①双倍段三个入口(ExpBefore/Gold/ExpAfter)由interface<①双倍时先打>按顺序开关,查到双倍就MAX打光;②平时段(HuntingGrounds/AdventureRoute)由<②平时打>二选一,打剩下的米饭。米饭已0的入口读到0/N直接出栈。末尾QuickHunt_Daily_Ck以And检查本轮米饭、火把耗尽tag,两者都有才走QuickHunt_Daily_Mark,缺一个则不打标",
        "timeout": 1,
        "next": [
            "[JumpBack]QuickHunt_OpenGui",
            "[JumpBack]QuickHunt_DoubleScan_ExpBefore",
            "[JumpBack]QuickHunt_DoubleScan_Gold",
            "[JumpBack]QuickHunt_DoubleScan_ExpAfter",
            "[JumpBack]QuickHunt_HuntingGrounds",
            "[JumpBack]QuickHunt_AdventureRoute",
            "[JumpBack]QuickHunt_RiceRecheck",
            "[JumpBack]QuickHunt_RiceZero_Ck",
            "[JumpBack]QuickHunt_CrystalCave",
            "[JumpBack]QuickHunt_Daily_Ck"
        ],
        "focus": "B.M 快速狩猎调度器"
    },
    "QuickHunt_Daily_Ck": {
        "desc": "完成条件检查(jb1):And确认本轮米饭、火把耗尽tag均小于0才记日常完成。CheckTag只支持当前值<max,故清零为0、耗尽写-1、检查max为0,缺标或检查失败均不通过",
        "max_hit": 1,
        "recognition": "And",
        "all_of": [
            {
                "sub_name": "RiceTag",
                "recognition": "Custom",
                "custom_recognition": "CheckTag",
                "custom_recognition_param": {
                    "tag": "RiceAP_Zero",
                    "max": 0
                }
            },
            {
                "sub_name": "TorchTag",
                "recognition": "Custom",
                "custom_recognition": "CheckTag",
                "custom_recognition_param": {
                    "tag": "TorchAP_Zero",
                    "max": 0
                }
            }
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "QuickHunt_Daily_Mark"
        ]
    },
    "QuickHunt_Daily_Mark": {
        "desc": "快速狩猎存档打标,只经QuickHunt_Daily_Ck到达:本轮米饭、火把耗尽tag均已确认,记本游戏日完成,之后进任务由QuickHunt_Daily_Switch直接跳过",
