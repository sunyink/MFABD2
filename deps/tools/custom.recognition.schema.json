{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$comment": "MFABD2 的 custom_recognition 声明，供编辑器补全与 scripts/verify_custom_schema.py 冷检查。由框架 pipeline.schema.json 经相对 $ref 引用，必须与它同目录；不参与上游 schema 同步。只约束「写错必出事」的情况：名字没注册、必填参数缺失、类型或取值不被代码接受、参数键拼错。可省略的参数一律不设 required。新增 Custom 时在这里补一条定义。x-node-ref / x-node-ref-keys 是本项目的扩展标注：值（或键）必须是已存在的节点名。只在运行时由 Python 创建、JSON 里找不到的节点，把名字列进顶层的 x-dynamic-nodes 即可免查。",
    "x-dynamic-nodes": [],
    "type": "object",
    "properties": {
        "custom_recognition": {
            "enum": [
                "RedDotDetector",
                "CheckCoolDown",
                "CheckTag",
                "TimerExpired",
                "NotRecognition",
                "OCRBestScore",
                "OCRItemName",
                "GoldVerdict",
                "HSVShapeMatching",
                "CookingStockSummary",
                "ArbitrageBuyRecordReady",
                "ArbitrageBuyNeedsScan",
                "ArbitrageBuyScanFinished",
                "AgentPing",
                "LootFeedPending"
            ]
        }
    },
    "anyOf": [
        {
            "$ref": "#/$defs/RedDotDetector"
        },
        {
            "$ref": "#/$defs/CheckCoolDown"
        },
        {
            "$ref": "#/$defs/CheckTag"
        },
        {
            "$ref": "#/$defs/TimerExpired"
        },
        {
            "$ref": "#/$defs/NotRecognition"
        },
        {
            "$ref": "#/$defs/OCRBestScore"
        },
        {
            "$ref": "#/$defs/OCRItemName"
        },
        {
            "$ref": "#/$defs/GoldVerdict"
        },
        {
            "$ref": "#/$defs/HSVShapeMatching"
        },
        {
            "$ref": "#/$defs/CookingStockSummary"
        },
        {
            "$ref": "#/$defs/ArbitrageBuyRecordReady"
        },
        {
            "$ref": "#/$defs/ArbitrageBuyNeedsScan"
        },
        {
            "$ref": "#/$defs/ArbitrageBuyScanFinished"
        },
        {
            "$ref": "#/$defs/AgentPing"
        },
        {
            "$ref": "#/$defs/LootFeedPending"
        }
    ],
    "$defs": {
        "RequiredParam": {
            "$comment": "参数必填。写成 <键>_code 表示该参数由代码在运行时注入，同样算填了。",
            "anyOf": [
                {
                    "required": [
                        "custom_recognition_param"
                    ]
                },
                {
                    "required": [
                        "custom_recognition_param_code"
                    ]
                }
            ]
        },
        "RedDotDetector": {
            "allOf": [
                {
                    "$ref": "#/$defs/RequiredParam"
                }
            ],
            "properties": {
                "custom_recognition": {
                    "const": "RedDotDetector",
                    "description": "红点（感叹号）识别。预设模式只写 preset；独立模式写筛选与打分参数，全部可省略。"
                },
                "custom_recognition_param": {
                    "type": "object",
                    "properties": {
                        "preset": {
                            "type": "string",
                            "minLength": 1,
                            "x-node-ref": true,
                            "description": "预设模式：复用这个节点的红点参数，只在本节点的 roi 里找。"
                        },
                        "flt_red_hsv": {
                            "type": "array",
                            "description": "筛选：红色的 HSV 范围列表。"
                        },
                        "hsv_ranges": {
                            "type": "array",
                            "description": "flt_red_hsv 的旧名。"
                        },
                        "flt_area": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2,
                            "description": "筛选：色块面积范围 [min, max]。"
                        },
                        "red_area": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2,
                            "description": "flt_area 的旧名。"
                        },
                        "flt_aspect": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2,
                            "description": "筛选：长宽比范围 [lo, hi]。"
                        },
                        "flt_hsv_rescue": {
                            "description": "筛选：HSV 救援配置。配置无效时救援关闭、识别照常进行。"
                        },
                        "sc_min_conf": {
                            "type": "number",
                            "description": "打分：最低置信度。"
                        },
                        "min_confidence": {
                            "type": "number",
                            "description": "sc_min_conf 的旧名。"
                        },
                        "sc_gap_ratio": {
                            "type": "number",
                            "description": "打分：间隙比例，仅用于结果标注。"
                        },
                        "gap_ratio": {
                            "type": "number",
                            "description": "sc_gap_ratio 的旧名。"
                        }
                    },
                    "additionalProperties": false
                }
            }
        },
        "CheckCoolDown": {
            "allOf": [
                {
                    "$ref": "#/$defs/RequiredParam"
                }
            ],
            "properties": {
                "custom_recognition": {
                    "const": "CheckCoolDown",
                    "description": "周期冷却判定：本周期还可执行则命中。单卡写 card_name；批量写 targets + match 当总闸。"
                },
                "custom_recognition_param": {
                    "type": "object",
                    "properties": {
                        "card_name": {
                            "type": "string",
                            "minLength": 1,
                            "description": "单卡模式：卡带（任务）代号。"
                        },
                        "cycle_type": {
                            "type": "string",
                            "enum": [
                                "g_weekly",
                                "g_daily",
                                "mirror_pvp",
                                "golden_pvp",
                                "mamono_weekly"
                            ],
                            "description": "周期策略，默认 g_weekly。写了不存在的策略会退回第一个策略并只打一条警告。"
                        },
                        "targets": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "card_name": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "卡带（任务）代号"
                                    },
                                    "cycle_type": {
                                        "type": "string",
                                        "enum": [
                                            "g_weekly",
                                            "g_daily",
                                            "mirror_pvp",
                                            "golden_pvp",
                                            "mamono_weekly"
                                        ],
                                        "description": "周期策略，默认 g_weekly。写了不存在的策略会退回第一个策略并只打一条警告。"
                                    }
                                },
                                "required": [
                                    "card_name"
                                ],
                                "additionalProperties": false
                            },
                            "minItems": 1,
                            "description": "批量模式：一次问一批卡带，结果按 match 聚合。"
                        },
                        "match": {
                            "type": "string",
                            "enum": [
                                "any",
                                "none",
                                "all_done"
                            ],
                            "description": "批量模式的聚合判据，默认 any。"
                        }
                    },
                    "anyOf": [
                        {
                            "required": [
                                "card_name"
                            ]
                        },
                        {
                            "required": [
                                "targets"
                            ]
                        }
                    ],
                    "additionalProperties": false
                }
            }
        },
        "CheckTag": {
            "allOf": [
                {
                    "$ref": "#/$defs/RequiredParam"
                }
            ],
            "properties": {
                "custom_recognition": {
                    "const": "CheckTag",
                    "description": "次数闸：标签当前值小于 max 则命中。"
                },
                "custom_recognition_param": {
                    "type": "object",
                    "properties": {
                        "tag": {
                            "type": "string",
                            "minLength": 1,
                            "description": "标签名。"
                        },
                        "max": {
                            "type": "number",
                            "description": "上限，默认 1。"
                        }
                    },
                    "required": [
                        "tag"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "TimerExpired": {
            "allOf": [
                {
                    "$ref": "#/$defs/RequiredParam"
                }
            ],
            "properties": {
                "custom_recognition": {
                    "const": "TimerExpired",
                    "description": "计时器到期判定：到了时间上限才命中。"
                },
                "custom_recognition_param": {
                    "type": "object",
                    "properties": {
                        "timer": {
                            "type": "string",
                            "description": "计时器名，默认 default。"
                        },
                        "minutes": {
                            "type": [
                                "number",
                                "string"
                            ],
                            "description": "时间上限（分钟）。小于等于 0 表示不限时。"
                        }
                    },
                    "additionalProperties": false
                }
            }
        },
        "NotRecognition": {
            "allOf": [
                {
                    "$ref": "#/$defs/RequiredParam"
                }
            ],
            "properties": {
                "custom_recognition": {
                    "const": "NotRecognition",
                    "description": "对另一个节点的识别结果取反。只接受单个节点名，多个条件用 And / Or 组合。"
                },
                "custom_recognition_param": {
                    "type": "object",
                    "properties": {
                        "node": {
                            "type": "string",
                            "minLength": 1,
                            "x-node-ref": true,
                            "description": "被取反的识别节点。"
                        }
                    },
                    "required": [
                        "node"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "OCRBestScore": {
            "allOf": [
                {
                    "$ref": "#/$defs/RequiredParam"
                }
            ],
            "properties": {
                "custom_recognition": {
                    "const": "OCRBestScore",
                    "description": "跑一个原生 OCR 节点，只取置信度最高的那条结果。"
                },
                "custom_recognition_param": {
                    "type": "object",
                    "properties": {
                        "node": {
                            "type": "string",
                            "minLength": 1,
                            "x-node-ref": true,
                            "description": "源节点，必须是原生 OCR。"
                        }
                    },
                    "required": [
                        "node"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "OCRItemName": {
            "allOf": [
                {
                    "$ref": "#/$defs/RequiredParam"
                }
            ],
            "properties": {
                "custom_recognition": {
                    "const": "OCRItemName",
                    "description": "商店物品名识别：先把列表文字归并成物品名，再按目标名筛选。一般由 Python 侧注入。"
                },
                "custom_recognition_param": {
                    "type": "object",
                    "properties": {
                        "node": {
                            "type": "string",
                            "minLength": 1,
                            "x-node-ref": true,
                            "description": "源 OCR 节点。"
                        },
                        "item_name": {
                            "type": "string",
                            "minLength": 1,
                            "description": "目标物品名。"
                        },
                        "name_slots": {
                            "description": "出售查找用：按卡片的名字框逐个读取。"
                        }
                    },
                    "required": [
                        "node",
                        "item_name"
                    ]
                }
            }
        },
        "GoldVerdict": {
            "allOf": [
                {
                    "$ref": "#/$defs/RequiredParam"
                }
            ],
            "properties": {
                "custom_recognition": {
                    "const": "GoldVerdict",
                    "description": "按金币增减判定成交：对比 GoldSnapshot 记下的基准。"
                },
                "custom_recognition_param": {
                    "type": "object",
                    "properties": {
                        "direction": {
                            "type": "string",
                            "enum": [
                                "decrease",
                                "increase"
                            ],
                            "description": "期望的变化方向。"
                        },
                        "expected_delta": {
                            "type": "integer",
                            "description": "期望的精确差额，符号要与 direction 一致；不写则只看方向。写 0 是占位：永不命中，等 Python 侧在运行时注入真实差额。"
                        },
                        "node": {
                            "type": "string",
                            "minLength": 1,
                            "x-node-ref": true,
                            "description": "读金币的 OCR 节点，默认 Arbitrage_Sell_GoldRead。"
                        }
                    },
                    "required": [
                        "direction"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "HSVShapeMatching": {
            "allOf": [
                {
                    "$ref": "#/$defs/RequiredParam"
                }
            ],
            "properties": {
                "custom_recognition": {
                    "const": "HSVShapeMatching",
                    "description": "先按 HSV 把画面二值化，再交给模板节点识别。hsv_map 与 target_node 两种写法二选一。"
                },
                "custom_recognition_param": {
                    "type": "object",
                    "properties": {
                        "hsv_map": {
                            "type": "object",
                            "x-node-ref-keys": true,
                            "description": "{识别节点名: HSV 范围或范围列表}，按顺序逐个尝试。"
                        },
                        "target_node": {
                            "type": "string",
                            "minLength": 1,
                            "x-node-ref": true,
                            "description": "单节点写法：二值化后交给它识别。"
                        },
                        "recognition": {
                            "type": "string",
                            "minLength": 1,
                            "x-node-ref": true,
                            "description": "target_node 的旧名。"
                        },
                        "hsv_ranges": {
                            "type": "array",
                            "description": "单节点写法：HSV 范围列表 [{lower, upper}, ...]。"
                        },
                        "lower_hsv": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            },
                            "minItems": 3,
                            "maxItems": 3,
                            "description": "单节点旧写法：HSV 下界。"
                        },
                        "upper_hsv": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            },
                            "minItems": 3,
                            "maxItems": 3,
                            "description": "单节点旧写法：HSV 上界。"
                        },
                        "edge_assist": {
                            "type": "boolean",
                            "description": "是否叠加边缘检测，默认 false。"
                        },
                        "edge_threshold": {
                            "type": "number",
                            "description": "边缘检测阈值，默认 15。"
                        },
                        "debug": {
                            "type": "boolean",
                            "description": "是否保存调试图，默认 false。"
                        }
                    },
                    "anyOf": [
                        {
                            "required": [
                                "hsv_map"
                            ]
                        },
                        {
                            "required": [
                                "target_node"
                            ]
                        },
                        {
                            "required": [
                                "recognition"
                            ]
                        }
                    ],
                    "additionalProperties": false
                }
            }
        },
        "CookingStockSummary": {
            "properties": {
                "custom_recognition": {
                    "const": "CookingStockSummary",
                    "description": "把料理库存采集的业务结果写进识别详情，由 Python 侧注入，不手写。"
                },
                "custom_recognition_param": {
                    "type": "object"
                }
            }
        },
        "ArbitrageBuyRecordReady": {
            "properties": {
                "custom_recognition": {
                    "const": "ArbitrageBuyRecordReady",
                    "description": "常规采购：扫描记录是否就绪。"
                }
            }
        },
        "ArbitrageBuyNeedsScan": {
            "properties": {
                "custom_recognition": {
                    "const": "ArbitrageBuyNeedsScan",
                    "description": "常规采购：是否还有待扫描目标。"
                }
            }
        },
        "ArbitrageBuyScanFinished": {
            "properties": {
                "custom_recognition": {
                    "const": "ArbitrageBuyScanFinished",
                    "description": "常规采购：扫描是否结束。"
                }
            }
        },
        "AgentPing": {
            "properties": {
                "custom_recognition": {
                    "const": "AgentPing",
                    "description": "Agent 存活探针：Agent 通道正常则命中。"
                }
            }
        },
        "LootFeedPending": {
            "properties": {
                "custom_recognition": {
                    "const": "LootFeedPending",
                    "description": "上次 LootFeedCollect 之后又用 LootFeedCast 点过技能、或有还没收取的条目时命中（框 0,0,1,1）；收完不再命中。"
                },
                "custom_recognition_param": {
                    "type": "object",
                    "properties": {
                        "feed": {
                            "type": "string",
                            "description": "会话名，与 LootFeedCast / LootFeedCollect 的一致，默认 default。"
                        }
                    },
                    "additionalProperties": false
                }
            }
        }
    }
}
